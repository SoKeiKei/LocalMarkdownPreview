root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.{cpp,h,cs,csproj,vcxproj,sln,ps1,bat,cmd}]
end_of_line = crlf

[*.{cpp,h,cs}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
